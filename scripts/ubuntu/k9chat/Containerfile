# k9chat — build context is the k9-aif-framework repo root, not this
# directory. k9chat is an in-repo example (examples/k9chat/) that imports
# the framework package (k9_aif_abb/) directly, so both must be in the
# build context together. This Containerfile lives under scripts/ubuntu/
# k9chat/ purely for organization; it is not itself the build context.
#
# Build (from the k9-aif-framework repo root):
#   podman build -t k9chat:latest -f scripts/ubuntu/k9chat/Containerfile .
# (build-run.sh does this for you.)

FROM registry.access.redhat.com/ubi9/python-311:latest

USER root
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

COPY k9_aif_abb ./k9_aif_abb
COPY examples/k9chat ./examples/k9chat

# examples/k9chat/data (bind-mounted at runtime) holds .chroma/ and the
# projects sqlite db, so they persist across image rebuilds -- see
# build-run.sh's K9CHAT_CHROMA_PATH/K9CHAT_PROJECTS_DB overrides.
RUN mkdir -p /app/data \
 && chown -R 1001:0 /app \
 && chmod -R g+rwX /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=7777

EXPOSE 7777

HEALTHCHECK --interval=30s --timeout=8s --start-period=15s --retries=3 \
  CMD python -c "import socket; socket.create_connection(('localhost', 7777), timeout=3).close()" \
      || exit 1

USER 1001

CMD ["python", "-m", "uvicorn", "examples.k9chat.app:app", "--host", "0.0.0.0", "--port", "7777"]
