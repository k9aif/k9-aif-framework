# K9Chat — environment config
#
# This is the ONE place every backend/LLM setting lives. config.yaml never
# hardcodes a host, model, or credential -- everything below is read via
# ${VAR:-default} in config.yaml, so cloning this repo and copying this
# file to .env is all that's needed to point k9chat at your own Ollama
# server. Copy this file to .env (gitignored, never commit real values)
# and fill in what's different from the defaults below.
#
#   cp .env.example .env

# ── LLM backend (Ollama) ─────────────────────────────────────────────────
# Where your Ollama server runs. Defaults to localhost -- set this to your
# own host (e.g. a GPU workstation on your LAN) if Ollama isn't local.
OLLAMA_BASE_URL=http://localhost:11434

# Cosmetic only -- shown in the UI's runtime info, never used for routing.
OLLAMA_DISPLAY_NAME=

# Model aliases used by inference.llm_factory in config.yaml. Any model
# you have pulled in Ollama works; these are just sane starting points.
K9CHAT_GENERAL_MODEL=qwen3.8:27b
K9CHAT_REASONING_MODEL=qwen3.8:27b
K9CHAT_GUARDIAN_MODEL=granite3-guardian:2b

# Embedding model used for the Projects feature and the always-on K9-AIF/
# K9X knowledge base (see knowledge_retriever.py / seed_knowledge_base.py).
K9CHAT_EMBEDDING_MODEL=nomic-embed-text

# Curated header dropdown (distinct from the Provider Settings panel's
# free-form "fetch everything this host has pulled" picker). Comma-
# separated; K9CHAT_GENERAL_MODEL above is always included even if you
# forget to list it here. Granite Guardian is deliberately a valid pick --
# it's a safety classifier, not a chat model, so selecting it and cranking
# the Unhinged/Profanity dials is a fun way to watch it just refuse.
K9CHAT_SELECTABLE_MODELS=qwen3.8:27b,deepseek-r1:32b,granite4.1-guardian:8b

# ── Storage (Projects feature + knowledge base) ─────────────────────────
# ChromaDB is embedded/local by default -- no external server needed.
# Point this at a mounted volume path when running in a container so data
# survives rebuilds (e.g. -v /host/path:/app/data, then set this to
# /app/data/.chroma).
K9CHAT_CHROMA_PATH=./.chroma

# SQLite DB for Project metadata (name, instructions, file list). Empty
# defaults to k9chat_projects.db alongside config.yaml. Same containerized-
# volume note as above applies (e.g. /app/data/k9chat_projects.db).
K9CHAT_PROJECTS_DB=

# ── Visitor identity (no password -- see auth.py's module docstring) ────
# Always on: every visitor picks a display name (or gets a random
# codename, like k9x_satan). No password -- a shared password shown on
# the page itself was never real bot protection; K9CHAT_MAX_CONCURRENT
# below is what actually guards the GPU. This step exists so Projects can
# be scoped per-visitor, not because it gates access.
#
# Random secret used to sign the session cookie -- generate your own, e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`. Falls back
# to a fixed dev-only value if left blank, so local use works with zero
# setup.
K9CHAT_SESSION_SECRET=

# ── Concurrency guard ─────────────────────────────────────────────────────
# At most this many real generations run against Ollama at once,
# process-wide. A request beyond that waits (reflected in the UI as a
# queue position / waitlist widget), never rejected outright -- same
# MAX_QUEUE_SIZE convention dow-k9-aif/DAS uses. This is the real defense
# against a burst of concurrent requests (bots or otherwise) pegging the
# GPU, not the old password gate.
K9CHAT_MAX_CONCURRENT=5

# Minimum seconds between model switches (the header dropdown / Settings
# panel). Switching loads a fresh multi-GB model into VRAM -- a real,
# heavier cost than a normal chat message. A cooldown, not a per-visitor
# limit, because the cost is per-switch and global (one shared model,
# process-wide), not tied to who's asking.
K9CHAT_MODEL_SWITCH_COOLDOWN_SECONDS=60

# ── GPU/CPU telemetry (right-side panel + real thermal guard) ───────────
# Real data, not simulated -- proxies a small nvidia-smi-backed server
# (Node/Express, GET /gpu). Point this at wherever that's actually
# running (same host as Ollama, by convention). If unreachable, the
# panel shows "unreachable" and the thermal guard fails open (never
# blocks jobs due to a monitoring outage).
K9CHAT_GPU_TELEMETRY_URL=http://localhost:5000/gpu

# New jobs pause (not killed if already running) while GPU temp is at or
# above this. Enforced in queue_control.py, not just displayed.
K9CHAT_GPU_TEMP_LIMIT_C=85

# ── Live internet search (Framework Mode toggle in the UI) ───────────────
# Self-hosted SearxNG (privacy-respecting metasearch, no API key/per-query
# cost). Off by default (config.yaml's internet_search.enabled) -- only
# used when Framework Mode is toggled OFF (general questions allowed).
K9CHAT_SEARXNG_URL=http://localhost:7070

# For a public/offline deployment where an untrusted visitor shouldn't be
# able to re-enable Internet mode or the Unhinged dial themselves -- when
# true, Framework Mode is forced ON and can't be toggled off via the UI/
# API, and Unhinged/Profanity are clamped to 0 server-side regardless of
# what a caller sends. Leave unset/false for normal home-network use.
K9CHAT_FRAMEWORK_MODE_LOCKED=false

# ── Runtime provider switching (Settings panel in the UI) ───────────────
# Optional. Only needed if you use the UI's Provider Settings panel to
# point k9chat at an OpenAI-compatible host that requires an API key.
# Never written to config.yaml or any file -- held in-process only.
K9CHAT_RUNTIME_API_KEY=
