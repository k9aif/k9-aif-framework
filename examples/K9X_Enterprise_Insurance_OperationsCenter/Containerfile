# K9-AIF Enterprise Insurance Operations Center
# RHEL UBI 9 Python 3.11 container image
#
# Build:
#   podman build -t k9-aif-eoc:latest \
#     -f examples/K9X_Enterprise_Insurance_OperationsCenter/Containerfile .
#
# Run standalone (dev):
#   podman run --rm -p 8010:8010 \
#     --env-file examples/K9X_Enterprise_Insurance_OperationsCenter/.env \
#     k9-aif-eoc:latest
#
# Run in pod (production):
#   see ubuntu/eoc-pod.yaml

FROM registry.access.redhat.com/ubi9/python-311:latest

USER root

# ── System packages ───────────────────────────────────────────
RUN dnf install -y --nodocs \
      gcc \
      libpq-devel \
    && dnf clean all

# ── Python dependencies ───────────────────────────────────────
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# ── Application source ────────────────────────────────────────
COPY . .

# COPY runs as root, so anything the app needs to write at runtime (log
# dirs, SQLite state, etc. — several framework code paths resolve these
# relative to cwd, i.e. /app) is otherwise unwritable by the non-root
# runtime user below. UID 1001 has no reliable identity here, only
# group-root membership, matching the arbitrary-UID convention RHEL/
# OpenShift base images expect (same fix DAS's and satan's Containerfiles
# already have for their own data dirs).
RUN chown -R 1001:0 /app && chmod -R g+rwX /app

# ── Runtime environment ───────────────────────────────────────
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    K9_ENV=production

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=8s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8010/health')" \
      || exit 1

# Drop to non-root (UBI default non-root UID)
USER 1001

CMD ["uvicorn", \
     "examples.K9X_Enterprise_Insurance_OperationsCenter.api.app:app", \
     "--host", "0.0.0.0", \
     "--port", "8010", \
     "--workers", "2", \
     "--log-level", "info"]
